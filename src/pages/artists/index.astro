---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArtists } from "../../lib/cms";

const artists = await getArtists();
---

<BaseLayout>
  <div class="page-header">
    <h1>Artists</h1>
  </div>

  <div class="artists-table-wrap">
    <table class="artists-table">
      <tbody>
        {artists.map((artist) => (
          <tr>
            <td class="col-name">{artist.name}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</BaseLayout>

<style>
  .artists-table-wrap {
    width: 100%;
    overflow-x: auto;
  }

  .artists-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .artists-table td {
    padding: 0.65rem 0;
    text-align: left;
    vertical-align: baseline;
    border-bottom: 1px solid #f0f0f0;
  }

  .col-name {
    width: 100%;
    font-size: 0.95rem;
    color: #1a1a1a;
  }

  @media (max-width: 640px) {
    .artists-table td {
      padding: 0.5rem 0;
    }
    .col-name {
      font-size: 0.85rem;
    }
  }
</style>
