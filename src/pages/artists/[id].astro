---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArtists, getArtistById, getArtistExhibitions } from "../../data";

export function getStaticPaths() {
  const artists = getArtists();
  return artists.map((a) => ({ params: { id: a.id } }));
}

const { id } = Astro.params;
const artist = getArtistById(id!);

if (!artist) {
  return Astro.redirect("/artists");
}

const exhibitions = getArtistExhibitions(artist.id);

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}
---

<BaseLayout>
  <div class="artist-detail">
    <header class="artist-header">
      <a href="/artists" class="back-link">← Artists</a>
      <h1>{artist.name}</h1>
      {artist.biography && (
        <div class="artist-bio" set:html={artist.biography
          .split("\n\n")
          .map(p => `<p>${p.replace(/\n/g, "<br/>")}</p>`)
          .join("")} />
      )}
    </header>

    {
      exhibitions.length > 0 && (
        <section class="artist-exhibitions">
          <h2 class="section-heading">Exhibitions</h2>
          <ul class="exhibition-list">
            {exhibitions.map((exhibition) => (
              <li>
                <a href={`/exhibitions/${exhibition.id}`} class="exhibition-link">
                  <span class="exhibition-name">{exhibition.title}</span>
                  <span class="exhibition-dates">
                    {formatDate(exhibition.startDate)} — {formatDate(exhibition.endDate)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }


  </div>
</BaseLayout>

<style>
  .artist-detail {
  }

  .artist-header {
    margin-bottom: 3rem;
  }

  .back-link {
    display: inline-block;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.65rem;
    color: #aaa;
    text-decoration: none;
    margin-bottom: 0.75rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #1a1a1a;
  }

  .artist-header h1 {
    font-size: 1.6rem;
    font-weight: 400;
    margin-bottom: 0.75rem;
  }

  .artist-bio {
    font-size: 1rem;
    color: #444;
    line-height: 1.6;
    max-width: 620px;
  }

  .artist-bio :global(p) {
    margin-bottom: 1rem;
  }

  .section-heading {
    font-size: 0.85rem;
    font-weight: 400;
    color: #aaa;
    font-style: italic;
    margin-bottom: 1rem;
  }

  .artist-exhibitions {
    margin-bottom: 3rem;
  }

  .exhibition-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .exhibition-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    text-decoration: none;
    color: #1a1a1a;
    padding: 0.5rem 0;
  }

  .exhibition-name {
    font-size: 1rem;
  }

  .exhibition-dates {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.7rem;
    color: #aaa;
    white-space: nowrap;
    margin-left: 1.5rem;
  }

  @media (max-width: 640px) {
    .exhibition-link {
      flex-direction: column;
      gap: 0.15rem;
    }
    .exhibition-dates {
      margin-left: 0;
    }
  }
</style>
