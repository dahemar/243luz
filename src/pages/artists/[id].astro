---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArtists, getArtistById, getArtistExhibitions } from "../../data";
import ImageViewer from "../../components/ImageViewer.astro";
import artistImagesData from "../../data/artistImages.ts";

export function getStaticPaths() {
  const artists = getArtists();
  return artists.map((a) => ({ params: { id: a.id } }));
}

const { id } = Astro.params;
const artist = getArtistById(id!);

if (!artist) {
  return Astro.redirect("/artists");
}

const exhibitions = getArtistExhibitions(artist.id);

// Artist gallery images from Wix folder
const artistImages: string[] = artist.portrait
  ? [artist.portrait, ...(artistImagesData[artist.id] || []).map(
      (img: string) => `/media/${artist.wixFolder}/${img}`
    )]
  : [];

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}
---

<BaseLayout>
  <div class="artist-detail">
    <header class="artist-header">
      <a href="/artists" class="back-link">← Artists</a>
      <div class="artist-top">
        {artist.portrait && (
          <img
            src={artist.portrait}
            alt={artist.name}
            class="artist-portrait"
          />
        )}
        <div class="artist-info">
          <h1>{artist.name}</h1>
          {artist.biography && (
            <div class="artist-bio" set:html={artist.biography
              .split("\n\n")
              .map(p => `<p>${p.replace(/\n/g, "<br/>")}</p>`)
              .join("")} />
          )}
        </div>
      </div>
    </header>

    {
      exhibitions.length > 0 && (
        <section class="artist-exhibitions">
          <h2 class="section-heading">Exhibitions at 243 Luz</h2>
          <ul class="exhibition-list">
            {exhibitions.map((exhibition) => (
              <li>
                <a href={`/exhibitions/${exhibition.id}`} class="exhibition-link">
                  <span class="exhibition-name">{exhibition.title}</span>
                  <span class="exhibition-dates">
                    {formatDate(exhibition.startDate)} — {formatDate(exhibition.endDate)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      artistImages.length > 0 && (
        <section class="artist-works">
          <h2 class="section-heading">Selected Works</h2>
          <ImageViewer images={artistImages}>
            <div class="works-grid">
              {artistImages.map((src) => (
                <figure class="work-figure">
                  <img src={src} alt="" loading="lazy" />
                </figure>
              ))}
            </div>
          </ImageViewer>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .artist-header {
    margin-bottom: 3rem;
  }

  .back-link {
    display: inline-block;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.65rem;
    color: #aaa;
    text-decoration: none;
    margin-bottom: 1.25rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #1a1a1a;
  }

  .artist-top {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
  }

  .artist-portrait {
    width: 220px;
    height: auto;
    flex-shrink: 0;
    background: #f8f8f8;
  }

  .artist-info h1 {
    font-size: 1.6rem;
    font-weight: 400;
    margin-bottom: 1rem;
  }

  .artist-bio {
    font-size: 1rem;
    color: #444;
    line-height: 1.6;
    max-width: 620px;
  }

  .artist-bio :global(p) {
    margin-bottom: 1rem;
  }

  .section-heading {
    font-size: 0.85rem;
    font-weight: 400;
    color: #aaa;
    font-style: italic;
    margin-bottom: 1rem;
  }

  .artist-exhibitions {
    margin-bottom: 3rem;
  }

  .exhibition-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .exhibition-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    text-decoration: none;
    color: #1a1a1a;
    padding: 0.5rem 0;
  }

  .exhibition-name {
    font-size: 1rem;
  }

  .exhibition-dates {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.7rem;
    color: #aaa;
    white-space: nowrap;
    margin-left: 1.5rem;
  }

  .artist-works {
    margin-bottom: 3rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.5rem;
  }

  .work-figure {
    margin: 0;
    line-height: 0;
  }

  .work-figure img {
    display: block;
    width: 100%;
    height: auto;
    background: #f8f8f8;
  }

  @media (max-width: 640px) {
    .artist-top {
      flex-direction: column;
      gap: 1.5rem;
    }
    .artist-portrait {
      width: 140px;
    }
    .exhibition-link {
      flex-direction: column;
      gap: 0.15rem;
    }
    .exhibition-dates {
      margin-left: 0;
    }
    .works-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }
</style>
