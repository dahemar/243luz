---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getExhibitionsNewestFirst, getEvents } from "../lib/cms";

const latestShow = (await getExhibitionsNewestFirst())[0];
const events = await getEvents();

function ordinal(n: number): string {
  const r10 = n % 10;
  const r100 = n % 100;
  if (r10 === 1 && r100 !== 11) return "st";
  if (r10 === 2 && r100 !== 12) return "nd";
  if (r10 === 3 && r100 !== 13) return "rd";
  return "th";
}

function formatShowDate(dateStr: string, includeYear: boolean): string {
  const m = dateStr.trim().match(/^(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})$/);
  if (m) {
    const day = parseInt(m[1], 10);
    const month = m[2].charAt(0).toUpperCase() + m[2].slice(1).toLowerCase();
    const year = m[3];
    return includeYear
      ? `${month} ${day}${ordinal(day)}, ${year}`
      : `${month} ${day}${ordinal(day)}`;
  }
  return dateStr;
}

function bookingLinks(event: {
  bookingUrl: string;
  bookingUrl2: string;
  date: string;
}): { label: string; url: string }[] {
  if (!event.bookingUrl) return [];
  if (!event.bookingUrl2) return [{ label: "", url: event.bookingUrl }];
  const parts = event.date.split("&").map((s) => s.trim());
  return [
    { label: parts[0] || "", url: event.bookingUrl },
    { label: parts[1] || "", url: event.bookingUrl2 },
  ];
}
---

<BaseLayout>
  <div class="home">
    {latestShow && (
      <div class="home-show">
        <a href={`/exhibitions/${latestShow.id}`} class="home-show-title">
          {latestShow.title}
        </a>
        {latestShow.description && (
          <p class="home-show-artist">{latestShow.description}</p>
        )}
        <p class="home-show-dates">
          {formatShowDate(latestShow.startDate, false)} -{" "}
          {formatShowDate(latestShow.endDate, true)}
        </p>
      </div>
    )}

    {events.length > 0 && (
      <section class="programme">
        <h2 class="programme-title">Programme</h2>
        <ul class="programme-list">
          {events.map((event) => (
            <li class="programme-event">
              <h3 class="event-name">{event.name}</h3>
              <p class="event-meta">
                {event.date}
                {event.location ? ` · ${event.location}` : ""}
              </p>
              {event.brief && <p class="event-brief">{event.brief}</p>}
              {bookingLinks(event).length > 0 && (
                <div class="event-register-group">
                  {bookingLinks(event).map((link) => (
                    <a
                      class="event-register"
                      href={link.url}
                      target="_blank"
                      rel="noopener"
                    >
                      Register here{link.label ? ` (${link.label})` : ""}
                    </a>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="home-contact">
      <p class="home-label">Opening Hours:</p>
      <p class="home-text">Wednesday – Saturday, 1 – 6 pm</p>

      <p class="home-address">
        First Floor, 1–7 Woburn Walk<br />
        London, WC1H 0JJ
      </p>

      <p class="home-email">
        <a href="mailto:info@243luz.com">info@243luz.com</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - 9rem);
  }

  .home-show {
    display: flex;
    flex-direction: column;
  }

  .home-show-title {
    font-size: 1.35rem;
    font-weight: 400;
    font-style: italic;
    color: #1a1a1a;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .home-show-title:hover {
    opacity: 0.6;
  }

  .home-show-artist {
    font-size: 1rem;
    color: #1a1a1a;
    margin-top: 0.15rem;
  }

  .home-show-dates {
    font-size: 0.85rem;
    color: #1a1a1a;
    margin-top: 0.15rem;
  }

  .programme {
    padding-top: 3rem;
    margin-top: 3rem;
  }

  .programme-title {
    font-size: 0.85rem;
    font-weight: 400;
    color: #aaa;
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .programme-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .programme-event {
    max-width: 620px;
  }

  .event-name {
    font-size: 1.05rem;
    font-weight: 400;
    color: #1a1a1a;
  }

  .event-meta {
    font-size: 0.8rem;
    color: #888;
    margin-top: 0.1rem;
  }

  .event-brief {
    font-size: 0.9rem;
    color: #444;
    line-height: 1.6;
    margin-top: 0.6rem;
  }

  .event-register-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .event-register {
    font-size: 0.85rem;
    color: #1a1a1a;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .event-register:hover {
    opacity: 0.5;
  }

  .home-contact {
    margin-top: auto;
    padding-top: 4rem;
    padding-bottom: 3rem;
    line-height: 1.3;
    max-width: 480px;
  }

  .home-label {
    font-size: 1.1rem;
    color: #1a1a1a;
    margin-bottom: 0;
  }

  .home-text {
    font-size: 1.1rem;
    color: #1a1a1a;
    margin-bottom: 1.5rem;
  }

  .home-address {
    font-size: 1.1rem;
    color: #1a1a1a;
    font-style: normal;
    margin-bottom: 1.25rem;
  }

  .home-email a {
    font-size: 1.1rem;
    color: #1a1a1a;
    text-decoration: none;
  }
</style>
