---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getExhibitions } from "../../data";
import type { Exhibition } from "../../data/exhibitions";

const exhibitions: Exhibition[] = getExhibitions().sort(
  (a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime()
);

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}
---

<BaseLayout>
  <div class="page-header">
    <h1>Exhibitions</h1>
  </div>

  <div class="exhibitions-list">
    {
      exhibitions.map((exhibition) => (
        <article class="exhibition-item">
          <a href={`/exhibitions/${exhibition.id}`} class="exhibition-link">
            <div class="exhibition-image">
              <img
                src={exhibition.featuredImage}
                alt={exhibition.title}
                loading="lazy"
                width="400"
                height="300"
                style="width:100%;height:100%;aspect-ratio:4/3;object-fit:cover;background:#f5f5f5;"
              />
            </div>
            <div class="exhibition-info">
              <h2 class="exhibition-title">{exhibition.title}</h2>
              <p class="exhibition-dates">
                {formatDate(exhibition.startDate)} — {formatDate(exhibition.endDate)}
              </p>
              {exhibition.description && (
                <p class="exhibition-description">{exhibition.description}</p>
              )}
            </div>
          </a>
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  .exhibitions-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 3rem 2rem;
  }

  .exhibition-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .exhibition-image {
    margin-bottom: 1rem;
    line-height: 0;
  }

  .exhibition-image img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.2s ease;
  }

  .exhibition-link:hover .exhibition-image img {
    opacity: 0.85;
  }

  .exhibition-title {
    font-size: 1.15rem;
    font-weight: 400;
    color: #1a1a1a;
    margin-bottom: 0.25rem;
    line-height: 1.3;
  }

  .exhibition-dates {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    color: #999;
    margin-bottom: 0.35rem;
  }

  .exhibition-description {
    font-size: 0.9rem;
    color: #666;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .exhibitions-list {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
