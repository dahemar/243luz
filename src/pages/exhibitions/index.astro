---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getExhibitions, getArtists } from "../../data";
import type { Exhibition } from "../../data/exhibitions";

const exhibitions: Exhibition[] = getExhibitions().sort(
  (a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime()
);

const galleryArtists = getArtists();
const artistIds = new Set(galleryArtists.map((a) => a.id));

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
}
---

<BaseLayout>
  <div class="page-header">
    <h1>Exhibitions</h1>
  </div>

  <div class="exhibitions-table-wrap">
    <table class="exhibitions-table">
      <tbody>
        {exhibitions.map((exhibition) => {
          // Link the description to the artist page when the artist is represented
          const linkable = exhibition.artistIds.filter((id) => artistIds.has(id));
          const link = linkable.length === 1 ? linkable[0] : null;
          return (
            <tr>
              <td class="col-title">
                <a href={`/exhibitions/${exhibition.id}`}>{exhibition.title}</a>
              </td>
              <td class="col-artists">
                {exhibition.description ? (
                  link ? (
                    <a href={`/artists/${link}`}>{exhibition.description}</a>
                  ) : (
                    exhibition.description
                  )
                ) : ""}
              </td>
              <td class="col-dates">
                {formatDate(exhibition.startDate)} — {formatDate(exhibition.endDate)}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</BaseLayout>

<style>
  .exhibitions-table-wrap {
    width: 100%;
    overflow-x: auto;
  }

  .exhibitions-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .exhibitions-table td {
    padding: 0.65rem 0;
    text-align: left;
    vertical-align: baseline;
    border-bottom: 1px solid #f0f0f0;
  }

  .col-title {
    width: 45%;
    font-size: 0.95rem;
    color: #1a1a1a;
    padding-right: 2rem;
  }

  .col-title a {
    text-decoration: none;
    color: #1a1a1a;
    transition: opacity 0.2s;
  }

  .col-title a:hover {
    opacity: 0.5;
  }

  .col-artists {
    width: 30%;
    font-size: 0.8rem;
    color: #666;
    font-style: italic;
    padding-right: 1.5rem;
  }

  .col-artists a {
    text-decoration: none;
    color: #666;
    font-style: normal;
    transition: opacity 0.2s;
  }

  .col-artists a:hover {
    opacity: 0.5;
  }

  .col-dates {
    font-size: 0.75rem;
    color: #aaa;
    font-style: italic;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .exhibitions-table td {
      padding: 0.5rem 0;
    }
    .col-title {
      font-size: 0.85rem;
      padding-right: 1rem;
      width: 55%;
    }
    .col-artists {
      font-size: 0.72rem;
    }
    .col-dates {
      display: none;
    }
  }
</style>
