---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getExhibitions } from "../../data";
import type { Exhibition } from "../../data/exhibitions";

const exhibitions: Exhibition[] = getExhibitions().sort(
  (a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime()
);

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}
---

<BaseLayout>
  <div class="exhibitions-header">
    <h1>Exhibitions</h1>
    <button id="view-toggle" class="view-toggle" aria-label="Toggle view">
      <span class="view-label-grid">grid</span>
      <span class="view-label-stack">stack</span>
    </button>
  </div>

  <div id="exhibitions-container" class="exhibitions-list view-grid">
    {
      exhibitions.map((exhibition) => (
        <article class="exhibition-item">
          <a href={`/exhibitions/${exhibition.id}`} class="exhibition-link">
            <div class="exhibition-image">
              <img
                src={exhibition.featuredImage}
                alt={exhibition.title}
                loading="lazy"
              />
            </div>
            <div class="exhibition-info">
              <h2 class="exhibition-title">{exhibition.title}</h2>
              <p class="exhibition-dates">
                {formatDate(exhibition.startDate)} — {formatDate(exhibition.endDate)}
              </p>
              {exhibition.description && (
                <p class="exhibition-description">{exhibition.description}</p>
              )}
            </div>
          </a>
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  .exhibitions-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2.5rem;
  }

  .exhibitions-header h1 {
    font-size: 1.4rem;
    font-weight: 400;
    color: #1a1a1a;
  }

  .view-toggle {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.65rem;
    color: #aaa;
    background: none;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }

  .view-toggle:hover {
    color: #1a1a1a;
  }

  .view-label-stack { display: none; }
  .view-grid .view-label-grid { display: none; }
  .view-grid .view-label-stack { display: inline; }

  .exhibitions-list {
    display: grid;
    gap: 3rem 2rem;
  }

  /* View 1: grid — uniform thumbnails */
  .view-grid {
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  .exhibition-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .exhibition-image {
    margin-bottom: 1rem;
    line-height: 0;
  }

  .exhibition-image img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.2s ease;
  }

  .view-grid .exhibition-image img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #f5f5f5;
  }

  .view-stack .exhibition-image img {
    background: #f8f8f8;
  }

  .exhibition-link:hover .exhibition-image img {
    opacity: 0.85;
  }

  .exhibition-title {
    font-size: 1.15rem;
    font-weight: 400;
    color: #1a1a1a;
    margin-bottom: 0.25rem;
    line-height: 1.3;
  }

  .exhibition-dates {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    color: #999;
    margin-bottom: 0.35rem;
  }

  .exhibition-description {
    font-size: 0.9rem;
    color: #666;
    line-height: 1.5;
  }

  /* View 2: stack — images at natural aspect ratio, 2 columns */
  .view-stack {
    grid-template-columns: 1fr 1fr;
    column-gap: 2rem;
    row-gap: 3rem;
  }

  .view-stack .exhibition-item:nth-child(even) {
    margin-top: 4rem;
  }

  .view-stack .exhibition-item:nth-child(4n+3),
  .view-stack .exhibition-item:nth-child(4n) {
    margin-top: 0;
  }

  .view-stack .exhibition-item:nth-child(n+3):nth-child(-n+4) {
    margin-top: 0;
  }

  @media (max-width: 640px) {
    .exhibitions-list {
      gap: 2.5rem;
    }
    .view-grid {
      grid-template-columns: 1fr;
    }
    .view-stack {
      grid-template-columns: 1fr;
    }
    .view-stack .exhibition-item:nth-child(even) {
      margin-top: 0;
    }
  }
</style>

<script>
  const container = document.getElementById("exhibitions-container");
  const toggle = document.getElementById("view-toggle");
  if (container && toggle) {
    toggle.addEventListener("click", () => {
      if (container.classList.contains("view-grid")) {
        container.classList.replace("view-grid", "view-stack");
      } else {
        container.classList.replace("view-stack", "view-grid");
      }
    });
  }
</script>
