---
const currentPath = Astro.url.pathname;
const isExhibitions = currentPath.startsWith("/exhibitions");
const isArtists = currentPath.startsWith("/artists");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="243 Luz — An art gallery in London" />
    <title>243 Luz</title>
    <link rel="icon" type="image/jpeg" href="/media/243 Lux - Co logo_edited.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="nav-logo">
          <img src="/media/243 Lux - Co logo.jpg" alt="243 Luz" class="logo-img" />
        </a>
        <div class="nav-links">
          <a href="/exhibitions" aria-current={isExhibitions ? "page" : undefined} class:list={[{ active: isExhibitions }]}>Exhibitions</a>
          <a href="/artists" aria-current={isArtists ? "page" : undefined} class:list={[{ active: isArtists }]}>Artists</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  ::selection {
    background: #1a1a1a;
    color: #fff;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 1px solid #1a1a1a;
    outline-offset: 2px;
  }

  body {
    font-family: "EB Garamond", Georgia, "Times New Roman", serif;
    color: #1a1a1a;
    background: #fff;
    line-height: 1.5;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 0.75rem 6rem;
  }

  main {
    animation: fadein 0.4s ease;
  }

  @keyframes fadein {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    main {
      animation: none;
    }
    *, *::before, *::after {
      transition-duration: 0.01ms !important;
    }
  }

  .site-header {
    padding: 1.25rem 0 1rem;
    margin-bottom: 2rem;
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-logo {
    font-size: 1.1rem;
    font-weight: 400;
    text-decoration: none;
    color: #1a1a1a;
    letter-spacing: 0.02em;
    line-height: 0;
  }

  .logo-img {
    height: 2.4rem;
    width: auto;
    margin: -0.2rem 0;
    margin-left: -0.35rem;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    font-family: "EB Garamond", Georgia, serif;
    font-size: 0.85rem;
    text-decoration: none;
    color: #1a1a1a;
    font-style: normal;
    transition: opacity 0.2s ease;
  }

  .nav-links a:hover {
    opacity: 0.5;
  }

  .nav-links a.active {
    border-bottom: 1px solid #1a1a1a;
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-size: 1.4rem;
    font-weight: 400;
    color: #1a1a1a;
  }

  hr {
    border: none;
    border-top: 1px solid #e5e5e5;
    margin: 3rem 0;
  }

  @media (max-width: 640px) {
    .site-header {
      position: sticky;
      top: 0;
      background: #fff;
      z-index: 100;
    }
    body {
      padding: 0 0.5rem 6rem;
    }
    .nav-links {
      gap: 1.25rem;
    }
    .site-header {
      padding: 1rem 0 0.75rem;
      margin-bottom: 1.5rem;
    }
  }
</style>
